# Copy to .env and fill in. .env is gitignored.

# Supabase Postgres - SESSION POOLER string (port 5432)
DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://<project>.supabase.co
SUPABASE_PUBLISHABLE_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI food recognition (any OpenAI-compatible vision API; Gemini by default)
VISION_AI_API_KEY=
VISION_AI_MODEL=gemini-3.5-flash-lite   # tested working with the free Gemini key; gemini-2.5-flash and gemini-3.5-flash also worked
# VISION_AI_PROVIDER=gemini
# VISION_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# VISION_AI_REASONING_EFFORT=low
# VISION_AI_TIMEOUT_SECONDS=30
# VISION_AUTO_LOG_THRESHOLD=0.90

# Optional
# LOCAL_IMAGE_DIR=storage/captures
# MAX_DEVICE_IMAGE_BYTES=5242880
# MAX_PHONE_IMAGE_BYTES=12582912
# WORKER_THREADS=4
# CORS_ORIGINS=*
